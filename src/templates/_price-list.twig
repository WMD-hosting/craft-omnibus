<!doctype html>
<html lang="{{ craft.app.language|split('-')|first }}">
<head>
  <meta charset="utf-8">
  <title>{{ 'Product price list'|t('omnibus') }}</title>
  <meta name="robots" content="index, follow">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>body{font:16px/1.5 system-ui,sans-serif;max-width:60rem;margin:2rem auto;padding:0 1rem;color:#111}h2{margin:2rem 0 .25rem;font-size:1.25rem}h3{margin:1.25rem 0 .25rem;font-size:1rem}table{border-collapse:collapse;width:100%}td,th{text-align:left;padding:.4rem .6rem;border-bottom:1px solid #ddd}small{color:#666}</style>
</head>
<body>
  <h1>{{ 'Product price list'|t('omnibus') }}</h1>
  <p>{{ 'Published under the Decision on publishing price lists of products and services (NN 101/2026). Files stay available for {days} days after publication. The anchor price refers to {date}.'|t('omnibus', { days: retentionDays, date: anchorDate|date('d.m.Y') }) }}</p>
  {% for day in days %}
    <section>
      <h2><time datetime="{{ day.date }}">{{ day.date|date('d.m.Y') }}</time></h2>
      {% for outlet in day.outlets %}
        <h3>{{ outlet.name }}{% if outlet.address %} <small>{{ outlet.address }}</small>{% endif %}</h3>
        <table>
          <thead><tr><th>{{ 'File'|t('omnibus') }}</th><th>{{ 'Published'|t('omnibus') }}</th><th>{{ 'Size'|t('omnibus') }}</th></tr></thead>
          <tbody>
            {% for f in outlet.files %}
              <tr><td><a href="{{ f.url }}">{{ f.name }}</a></td><td>{{ f.time }}</td><td><small>{{ (f.size / 1024)|number_format(1) }} kB</small></td></tr>
            {% endfor %}
          </tbody>
        </table>
      {% endfor %}
    </section>
  {% else %}
    <p>{{ 'The price list has not been published yet.'|t('omnibus') }}</p>
  {% endfor %}
</body>
</html>
