{% set title = "Product Price History" %}
{% set iso = craft.commerce.paymentCurrencies.primaryPaymentCurrencyIso %}

<!-- Search Section - Always Visible -->
<div class="search-section" style="margin-bottom: 24px; position: sticky; top: 0; background: white; z-index: 100; padding: 16px 0; border-bottom: 1px solid #e5e7eb;">
    <div class="search-container" style="display: flex; gap: 12px; align-items: center;">
        <div style="flex: 1;">
            <input 
                type="text" 
                id="search-input" 
                placeholder="Search products and variants by title or description..." 
                style="width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 14px;"
                value="{{ craft.app.request.getQueryParam('search') }}"
            >
        </div>
        <button 
            id="search-btn" 
            style="background: #0d78f2; color: white; border: none; padding: 10px 16px; border-radius: 6px; font-size: 14px; cursor: pointer; transition: background-color 0.2s;"
            onmouseover="this.style.backgroundColor='#0b6bc7'"
            onmouseout="this.style.backgroundColor='#0d78f2'">
            Search
        </button>
        <button 
            id="clear-search-btn" 
            style="background: #6b7280; color: white; border: none; padding: 10px 16px; border-radius: 6px; font-size: 14px; cursor: pointer; transition: background-color 0.2s;"
            onmouseover="this.style.backgroundColor='#4b5563'"
            onmouseout="this.style.backgroundColor='#6b7280'">
            Clear
        </button>
    </div>
    <div id="search-status" style="margin-top: 8px; font-size: 14px; color: #6b7280;"></div>
</div>

<!-- Main Content Area -->
<div class="product-price-history">
    <!-- Content Container -->
    <div id="results-container">
        {% if data.products|length %}
            <!-- Header Stats -->
            <div class="utility-header" style="margin-bottom: 24px;">
                <h2>{{ title }}</h2>
                <p class="light">
                    Showing {{ data.products|length }} product{{ data.products|length != 1 ? 's' : '' }} 
                    ({{ data.pagination.totalProducts }} total)
                </p>
            </div>

        <!-- Products List -->
        <div class="product-list">
            {% for productData in data.products %}
                {% set product = productData.product %}
                
                <div class="product-item" style="margin-bottom: 32px; border: 1px solid #e3e5e8; border-radius: 6px; background: #fff;">
                    <!-- Product Header -->
                    <div class="product-header" style="padding: 16px 20px; border-bottom: 1px solid #e3e5e8; background: #f9fafb;">
                        <div class="flex" style="display: flex; align-items: center; justify-content: space-between;">
                            <div>
                                <h3 style="margin: 0; font-size: 16px; font-weight: 600; color: #1f2937;">
                                    <a href="{{ product.cpEditUrl }}">{{ product.title }}</a>
                                </h3>
                                <p style="margin: 4px 0 0 0; font-size: 14px; color: #6b7280;">
                                    Product ID: {{ product.id }} | 
                                    SKU: {{ product.defaultSku ?: 'N/A' }}
                                </p>
                            </div>
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <div style="font-size: 12px; color: #9ca3af;">
                                    {{ productData.variants|length }} variant{{ productData.variants|length != 1 ? 's' : '' }}
                                </div>
                                <button 
                                    class="toggle-variants-btn" 
                                    data-product-id="{{ product.id }}"
                                    style="background: #0d78f2; color: white; border: none; padding: 6px 12px; border-radius: 4px; font-size: 12px; cursor: pointer; transition: background-color 0.2s;"
                                    onmouseover="this.style.backgroundColor='#0b6bc7'"
                                    onmouseout="this.style.backgroundColor='#0d78f2'">
                                    Show Variants
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Variants -->
                    <div class="product-variants" id="variants-{{ product.id }}" style="padding: 0; display: none;">
                        {% for variantData in productData.variants %}
                            {% set variant = variantData.variant %}
                            {% set priceHistory = variantData.priceHistory %}
                            
                            <div class="variant-item" style="border-bottom: 1px solid #f3f4f6; last-child:border-bottom: none;">
                                <!-- Variant Header -->
                                <div class="variant-header" style="padding: 16px 20px; background: #fafbfc;">
                                    <div class="flex" style="display: flex; align-items: center; justify-content: space-between;">
                                        <div>
                                            <h4 style="margin: 0; font-size: 15px; font-weight: 500; color: #374151;">
                                                {{ variant.title ?: 'Default Variant' }}
                                            </h4>
                                            <p style="margin: 4px 0 0 0; font-size: 13px; color: #6b7280;">
                                                Variant ID: {{ variant.id }} | 
                                                SKU: {{ variant.sku ?: 'N/A' }} |
                                                Current Price: {{ variant.price|commerceCurrency(iso, convert=false, stripZeros=true) }}
                                            </p>
                                        </div>
                                        <div style="font-size: 12px; color: #9ca3af;">
                                            {{ priceHistory|length }} price change{{ priceHistory|length != 1 ? 's' : '' }}
                                        </div>
                                    </div>
                                </div>

                                <!-- Price History -->
                                <div class="price-history" style="padding: 0 20px 16px 20px;">
                                    {% if priceHistory|length %}
                                        <table class="data fullwidth" style="margin-top: 12px;">
                                            <thead>
                                                <tr>
                                                    <th style="width: 120px;">Price</th>
                                                    <th style="width: 180px;">Date Changed</th>
                                                    <th>Price Difference</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% set previousPrice = null %}
                                                {% for historyRecord in priceHistory %}
                                                    <tr>
                                                        <td>
                                                                                                                                <strong style="font-size: 14px; color: #059669;">
                                                                    {{ historyRecord.price|commerceCurrency(iso, convert=false, stripZeros=true) }}
                                                                </strong>
                                                        </td>
                                                        <td style="color: #6b7280; font-size: 13px;">
                                                            {{ historyRecord.dateChanged|date('M j, Y g:i A') }}
                                                        </td>
                                                        <td>
                                                            {% if previousPrice is not null %}
                                                                {% set difference = historyRecord.price - previousPrice %}
                                                                {% if difference > 0 %}
                                                                                                                                                <span style="color: #dc2626; font-size: 13px;">
                                                                            ↗ +{{ difference|commerceCurrency(iso, convert=false, stripZeros=true) }}
                                                                        </span>
                                                                                                                                        {% elseif difference < 0 %}
                                                                        <span style="color: #059669; font-size: 13px;">
                                                                            ↘ {{ difference|commerceCurrency(iso, convert=false, stripZeros=true) }}
                                                                        </span>
                                                                {% else %}
                                                                    <span style="color: #6b7280; font-size: 13px;">No change</span>
                                                                {% endif %}
                                                            {% else %}
                                                                <span style="color: #6b7280; font-size: 13px;">Initial price</span>
                                                            {% endif %}
                                                            {% set previousPrice = historyRecord.price %}
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    {% else %}
                                        <p style="color: #9ca3af; font-style: italic; margin: 12px 0;">No price history available</p>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>

        <!-- Pagination -->
        {% if data.pagination.totalPages > 1 %}
            <div class="pagination-wrapper" style="margin-top: 32px; text-align: center;">
                <nav class="pagination">
                    {% set currentPage = data.pagination.currentPage %}
                    {% set totalPages = data.pagination.totalPages %}
                    
                    <!-- Previous Button -->
                    {% if currentPage > 1 %}
                        <a href="?page={{ currentPage - 1 }}" class="btn">← Previous</a>
                    {% else %}
                        <span class="btn disabled">← Previous</span>
                    {% endif %}

                    <!-- Page Numbers -->
                    {% set startPage = max(1, currentPage - 2) %}
                    {% set endPage = min(totalPages, currentPage + 2) %}
                    
                    {% if startPage > 1 %}
                        <a href="?page=1" class="btn">1</a>
                        {% if startPage > 2 %}
                            <span class="btn disabled">...</span>
                        {% endif %}
                    {% endif %}

                    {% for page in startPage..endPage %}
                        {% if page == currentPage %}
                            <span class="btn submit">{{ page }}</span>
                        {% else %}
                            <a href="?page={{ page }}" class="btn">{{ page }}</a>
                        {% endif %}
                    {% endfor %}

                    {% if endPage < totalPages %}
                        {% if endPage < totalPages - 1 %}
                            <span class="btn disabled">...</span>
                        {% endif %}
                        <a href="?page={{ totalPages }}" class="btn">{{ totalPages }}</a>
                    {% endif %}

                    <!-- Next Button -->
                    {% if currentPage < totalPages %}
                        <a href="?page={{ currentPage + 1 }}" class="btn">Next →</a>
                    {% else %}
                        <span class="btn disabled">Next →</span>
                    {% endif %}
                </nav>
                
                <p style="margin: 16px 0 0 0; color: #6b7280; font-size: 14px;">
                    Page {{ currentPage }} of {{ totalPages }} 
                    ({{ data.pagination.totalProducts }} total products)
                </p>
            </div>
        {% endif %}

    {% else %}
        <!-- Empty State -->
        <div class="zilch" style="text-align: center; padding: 64px 0;">
            <h2>No Price History Found</h2>
            <p>There are no products with price history records yet.</p>
        </div>
    {% endif %}
    </div>
</div>

<style>
    .product-price-history .pagination .btn {
        margin: 0 4px;
        padding: 8px 12px;
        text-decoration: none;
        border-radius: 4px;
        display: inline-block;
    }
    
    .product-price-history .pagination .btn:hover:not(.disabled):not(.submit) {
        background-color: #f3f4f6;
    }
    
    .product-price-history .pagination .btn.disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    
    .product-price-history .pagination .btn.submit {
        background-color: #0d78f2;
        color: white;
    }
    
    .product-price-history .variant-item:last-child {
        border-bottom: none !important;
    }
    
    .product-price-history .data th {
        font-weight: 600;
        background-color: #f9fafb;
        padding: 8px 12px;
        border-bottom: 1px solid #e5e7eb;
    }
    
    .product-price-history .data td {
        padding: 8px 12px;
        border-bottom: 1px solid #f3f4f6;
    }
    
    .product-price-history .data tbody tr:hover {
        background-color: #f9fafb;
    }
    
    .product-variants {
        transition: all 0.3s ease;
    }
    
    .toggle-variants-btn {
        transition: background-color 0.2s ease;
    }
    
    .search-section {
        position: sticky !important;
        top: 0 !important;
        z-index: 10000 !important;
    }
    
    #search-input {
        display: block !important;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Search functionality
        const searchInput = document.getElementById('search-input');
        const searchBtn = document.getElementById('search-btn');
        const clearSearchBtn = document.getElementById('clear-search-btn');
        const searchStatus = document.getElementById('search-status');
        const resultsContainer = document.getElementById('results-container');
        
        let searchTimeout;
        
        // Helper function to keep search bar visible and focused
        function makeSearchBarVisible(searchTerm = '') {
            const searchInput = document.getElementById('search-input');
            
            if (searchInput) {
                // Keep the search term in the input
                if (searchTerm !== undefined) {
                    searchInput.value = searchTerm;
                }
                // put the cursor back in the field
                searchInput.focus();
            }
        }
        
        // Search function
        function performSearch(searchTerm = '', page = 1) {
            searchStatus.textContent = 'Searching...';
            
            const formData = new FormData();
            formData.append('searchTerm', searchTerm);
            formData.append('page', page);
            formData.append('CRAFT_CSRF_TOKEN', '{{ craft.app.request.csrfToken }}');
            
            fetch('{{ actionUrl("omnibus/product-price-history/search") }}', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.text().then(text => {
                    try {
                        return JSON.parse(text);
                    } catch (e) {
                        console.error('Response text:', text);
                        throw new Error('Invalid JSON response');
                    }
                });
            })
            .then(data => {
                if (data.success) {
                    updateContent(data.data, searchTerm);
                    searchStatus.textContent = `Found ${data.data.products.length} product${data.data.products.length !== 1 ? 's' : ''} (${data.data.pagination.totalProducts} total)`;
                    // Ensure search input keeps the current search term
                    searchInput.value = searchTerm;
                } else {
                    searchStatus.textContent = 'Search failed. Please try again.';
                }
            })
            .catch(error => {
                console.error('Search error:', error);
                console.error('Error details:', {
                    message: error.message,
                    stack: error.stack
                });
                searchStatus.textContent = 'Search failed. Please try again.';
            });
        }
        
        // Update content with search results
        function updateContent(data, searchTerm) {
            let html = '';
            
            if (data.products.length > 0) {
                // Header Stats
                html += `
                    <div class="utility-header" style="margin-bottom: 24px;">
                        <h2>Product Price History</h2>
                        <p class="light">
                            Showing ${data.products.length} product${data.products.length !== 1 ? 's' : ''} 
                            (${data.pagination.totalProducts} total)
                            ${searchTerm ? ` for "${searchTerm}"` : ''}
                        </p>
                    </div>
                `;
                
                // Products List
                html += '<div class="product-list">';
                
                data.products.forEach(productData => {
                    const product = productData.product;
                    const variants = productData.variants;
                    
                    html += `
                        <div class="product-item" style="margin-bottom: 32px; border: 1px solid #e3e5e8; border-radius: 6px; background: #fff;">
                            <!-- Product Header -->
                            <div class="product-header" style="padding: 16px 20px; border-bottom: 1px solid #e3e5e8; background: #f9fafb;">
                                <div class="flex" style="display: flex; align-items: center; justify-content: space-between;">
                                    <div>
                                        <h3 style="margin: 0; font-size: 16px; font-weight: 600; color: #1f2937;">
                                            <a href="${product.cpEditUrl}">${product.title}</a>
                                        </h3>
                                        <p style="margin: 4px 0 0 0; font-size: 14px; color: #6b7280;">
                                            Product ID: ${product.id} | 
                                            SKU: ${product.defaultSku || 'N/A'}
                                        </p>
                                    </div>
                                    <div style="display: flex; align-items: center; gap: 12px;">
                                        <div style="font-size: 12px; color: #9ca3af;">
                                            ${variants.length} variant${variants.length !== 1 ? 's' : ''}
                                        </div>
                                        <button 
                                            class="toggle-variants-btn" 
                                            data-product-id="${product.id}"
                                            style="background: #0d78f2; color: white; border: none; padding: 6px 12px; border-radius: 4px; font-size: 12px; cursor: pointer; transition: background-color 0.2s;"
                                            onmouseover="this.style.backgroundColor='#0b6bc7'"
                                            onmouseout="this.style.backgroundColor='#0d78f2'">
                                            Show Variants
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Variants -->
                            <div class="product-variants" id="variants-${product.id}" style="padding: 0; display: none;">
                    `;
                    
                    variants.forEach(variantData => {
                        const variant = variantData.variant;
                        const priceHistory = variantData.priceHistory;
                        
                        html += `
                            <div class="variant-item" style="border-bottom: 1px solid #f3f4f6; last-child:border-bottom: none;">
                                <!-- Variant Header -->
                                <div class="variant-header" style="padding: 16px 20px; background: #fafbfc;">
                                    <div class="flex" style="display: flex; align-items: center; justify-content: space-between;">
                                        <div>
                                            <h4 style="margin: 0; font-size: 15px; font-weight: 500; color: #374151;">
                                                ${variant.title || 'Default Variant'}
                                            </h4>
                                            <p style="margin: 4px 0 0 0; font-size: 13px; color: #6b7280;">
                                                Variant ID: ${variant.id} | 
                                                SKU: ${variant.sku || 'N/A'} |
                                                Current Price: ${variant.price}
                                            </p>
                                        </div>
                                        <div style="font-size: 12px; color: #9ca3af;">
                                            ${priceHistory.length} price change${priceHistory.length !== 1 ? 's' : ''}
                                        </div>
                                    </div>
                                </div>

                                <!-- Price History -->
                                <div class="price-history" style="padding: 0 20px 16px 20px;">
                        `;
                        
                        if (priceHistory.length > 0) {
                            html += `
                                <table class="data fullwidth" style="margin-top: 12px;">
                                    <thead>
                                        <tr>
                                            <th style="width: 120px;">Price</th>
                                            <th style="width: 180px;">Date Changed</th>
                                            <th>Price Difference</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                            `;
                            
                            let previousPrice = null;
                            priceHistory.forEach(historyRecord => {
                                const price = historyRecord.price;
                                const dateChanged = new Date(historyRecord.dateChanged).toLocaleString();
                                
                                let priceDifference = '';
                                if (previousPrice !== null) {
                                    const difference = price - previousPrice;
                                    if (difference > 0) {
                                        priceDifference = `<span style="color: #dc2626; font-size: 13px;">↗ +${difference}</span>`;
                                    } else if (difference < 0) {
                                        priceDifference = `<span style="color: #059669; font-size: 13px;">↘ ${difference}</span>`;
                                    } else {
                                        priceDifference = '<span style="color: #6b7280; font-size: 13px;">No change</span>';
                                    }
                                } else {
                                    priceDifference = '<span style="color: #6b7280; font-size: 13px;">Initial price</span>';
                                }
                                previousPrice = price;
                                
                                html += `
                                    <tr>
                                        <td>
                                            <strong style="font-size: 14px; color: #059669;">${price}</strong>
                                        </td>
                                        <td style="color: #6b7280; font-size: 13px;">${dateChanged}</td>
                                        <td>${priceDifference}</td>
                                    </tr>
                                `;
                            });
                            
                            html += `
                                    </tbody>
                                </table>
                            `;
                        } else {
                            html += '<p style="color: #9ca3af; font-style: italic; margin: 12px 0;">No price history available</p>';
                        }
                        
                        html += `
                                </div>
                            </div>
                        `;
                    });
                    
                    html += `
                            </div>
                        </div>
                    `;
                });
                
                html += '</div>';
                
                // Pagination
                if (data.pagination.totalPages > 1) {
                    html += `
                        <div class="pagination-wrapper" style="margin-top: 32px; text-align: center;">
                            <nav class="pagination">
                    `;
                    
                    const currentPage = data.pagination.currentPage;
                    const totalPages = data.pagination.totalPages;
                    
                    // Previous Button
                    if (currentPage > 1) {
                        html += `<a href="#" class="btn pagination-btn" data-page="${currentPage - 1}">← Previous</a>`;
                    } else {
                        html += '<span class="btn disabled">← Previous</span>';
                    }
                    
                    // Page Numbers
                    const startPage = Math.max(1, currentPage - 2);
                    const endPage = Math.min(totalPages, currentPage + 2);
                    
                    if (startPage > 1) {
                        html += `<a href="#" class="btn pagination-btn" data-page="1">1</a>`;
                        if (startPage > 2) {
                            html += '<span class="btn disabled">...</span>';
                        }
                    }
                    
                    for (let page = startPage; page <= endPage; page++) {
                        if (page === currentPage) {
                            html += `<span class="btn submit">${page}</span>`;
                        } else {
                            html += `<a href="#" class="btn pagination-btn" data-page="${page}">${page}</a>`;
                        }
                    }
                    
                    if (endPage < totalPages) {
                        if (endPage < totalPages - 1) {
                            html += '<span class="btn disabled">...</span>';
                        }
                        html += `<a href="#" class="btn pagination-btn" data-page="${totalPages}">${totalPages}</a>`;
                    }
                    
                    // Next Button
                    if (currentPage < totalPages) {
                        html += `<a href="#" class="btn pagination-btn" data-page="${currentPage + 1}">Next →</a>`;
                    } else {
                        html += '<span class="btn disabled">Next →</span>';
                    }
                    
                    html += `
                            </nav>
                            <p style="margin: 16px 0 0 0; color: #6b7280; font-size: 14px;">
                                Page ${currentPage} of ${totalPages} 
                                (${data.pagination.totalProducts} total products)
                            </p>
                        </div>
                    `;
                }
            } else {
                html += `
                    <div class="zilch" style="text-align: center; padding: 64px 0;">
                        <h2>No Results Found</h2>
                        <p>No products found matching your search criteria.</p>
                    </div>
                `;
            }
            
            resultsContainer.innerHTML = html;
            
            // Keep search-section
            const searchSection = document.getElementById('search-section');
            if (searchSection) {
                searchSection.style.display = 'block';
                searchSection.style.visibility = 'visible';
                searchSection.style.opacity = '1';
            }
            
            // Re-attach listeners
            attachToggleListeners();
            attachPaginationListeners();
        }
        
        // Attach toggle event listeners
        function attachToggleListeners() {
            document.querySelectorAll('.toggle-variants-btn').forEach(function(button) {
                button.addEventListener('click', function() {
                    const productId = this.getAttribute('data-product-id');
                    const variantsContainer = document.getElementById('variants-' + productId);
                    
                    if (variantsContainer.style.display === 'none') {
                        // Show variants
                        variantsContainer.style.display = 'block';
                        this.textContent = 'Hide Variants';
                        this.style.backgroundColor = '#dc2626';
                        this.onmouseover = function() { this.style.backgroundColor = '#b91c1c'; };
                        this.onmouseout = function() { this.style.backgroundColor = '#dc2626'; };
                    } else {
                        // Hide variants
                        variantsContainer.style.display = 'none';
                        this.textContent = 'Show Variants';
                        this.style.backgroundColor = '#0d78f2';
                        this.onmouseover = function() { this.style.backgroundColor = '#0b6bc7'; };
                        this.onmouseout = function() { this.style.backgroundColor = '#0d78f2'; };
                    }
                });
            });
        }
        
        // Attach pagination event listeners
        function attachPaginationListeners() {
            document.querySelectorAll('.pagination-btn').forEach(function(link) {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    const page = parseInt(this.getAttribute('data-page'));
                    const searchTerm = searchInput.value.trim();
                    performSearch(searchTerm, page);
                });
            });
        }
        
        // Search button click
        searchBtn.addEventListener('click', function() {
            const searchTerm = searchInput.value.trim();
            performSearch(searchTerm, 1);
        });
        
        // Clear search button click
        clearSearchBtn.addEventListener('click', function() {
            searchInput.value = '';
            searchStatus.textContent = '';
            location.reload(); // Reload to show all data
        });
        
        // Search on Enter key
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                const searchTerm = searchInput.value.trim();
                performSearch(searchTerm, 1);
            }
        });
        

        
        // Initial toggle listeners
        attachToggleListeners();
    });
</script>

